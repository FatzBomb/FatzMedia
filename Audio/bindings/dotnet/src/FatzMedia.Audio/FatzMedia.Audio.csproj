<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <RootNamespace>FatzMedia.Audio</RootNamespace>
    <!-- Must differ from the native "fatzaudio" library: Windows file names are case-insensitive. -->
    <AssemblyName>FatzMedia.Audio</AssemblyName>

    <PackageId>FatzMedia.Audio</PackageId>
    <!-- The version comes from FA_VERSION_* in the C header, the one place it is set (see CHANGELOG.md). -->
    <FatzAudioHeader>$(MSBuildThisFileDirectory)../../../../include/fatzaudio/fatzaudio.h</FatzAudioHeader>
    <VersionPrefix>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(FatzAudioHeader)')), '(?m)^#define FA_VERSION_MAJOR (\d+)').Groups[1].Value).$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(FatzAudioHeader)')), '(?m)^#define FA_VERSION_MINOR (\d+)').Groups[1].Value).$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(FatzAudioHeader)')), '(?m)^#define FA_VERSION_PATCH (\d+)').Groups[1].Value)</VersionPrefix>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/FatzBomb/FatzMedia</RepositoryUrl>
    <Authors>FatzBomb Entertainment</Authors>
    <Company>FatzBomb Entertainment</Company>
    <Copyright>Copyright (c) 2026 FatzBomb Entertainment. All rights reserved.</Copyright>
    <Description>.NET binding for the FatzMedia.Audio native audio engine: playback, decoding, crossfades, markers and more behind an idiomatic API.</Description>
    <PackageTags>audio;playback;decoder;crossfade;dj;karaoke</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>

    <!--
      Directory that contains the freshly built native win-x64 library (fatzaudio.dll).
      Override with -p:FatzAudioNativeDir=... . Defaults to the CMake Release output of this repository.
      Native binaries for other platforms are packed from runtimes/<rid>/native/ inside this project folder.
    -->
    <FatzAudioNativeDir Condition="'$(FatzAudioNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\build\bin\Release</FatzAudioNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FatzMedia.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\..\LICENSE" Pack="true" PackagePath="\" />
    <!-- The third-party licenses (BSD, MIT, zlib) must travel with the binaries -->
    <None Include="..\..\..\..\THIRD_PARTY_LICENSES.txt" Pack="true" PackagePath="\" />
    <!-- Native libraries staged under runtimes/<rid>/native in this project folder -->
    <None Include="runtimes\**\native\*" Pack="true" PackagePath="runtimes\" />
    <!-- iOS: the xcframework (folders), and the MSBuild file that links it into iOS apps -->
    <None Include="runtimes\ios\native\**" Pack="true" PackagePath="runtimes\ios\native\" />
    <None Include="msbuild\FatzMedia.Audio.targets" Pack="true" PackagePath="build" />
    <!-- win-x64 library from the CMake build -->
    <None Include="$(FatzAudioNativeDir)\fatzaudio.dll"
          Condition="Exists('$(FatzAudioNativeDir)\fatzaudio.dll')"
          Pack="true" PackagePath="runtimes\win-x64\native\"
          Link="runtimes\win-x64\native\fatzaudio.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
