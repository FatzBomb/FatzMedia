<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FatzMedia.Video.WinForms</AssemblyName>
    <RootNamespace>FatzMedia.Video.WinForms</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>FatzMedia.Video.WinForms</PackageId>
    <Description>WinForms adapter for FatzMedia.Video: an HWND MediaSurface control (frame-sink fallback, overlay content), a second-screen window, and the karaoke and background controls. Owns no rendering or media logic.</Description>
    <PackageProjectUrl>https://github.com/FatzBomb/FatzMedia</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatzMedia.Video\FatzMedia.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FatzMedia.Video.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
