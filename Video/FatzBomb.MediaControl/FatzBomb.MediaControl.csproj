<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- NuGet metadata. Pack explicitly at release time (dotnet pack -c Release); not on every build. -->
		<IsPackable>true</IsPackable>
		<PackageId>FatzBomb.MediaControl</PackageId>
		<AssemblyName>FatzBomb.MediaControl</AssemblyName>
		<RootNamespace>FatzBomb.MediaControl</RootNamespace>
		<Description>Host-agnostic FatzBomb media engine core for audio/video/image/CD+G input, Cdg rendering, Direct3D composition primitives, BASS/FFmpeg integration, normalization, and effects.</Description>
		<PackageProjectUrl>https://github.com/FatzBomb75/FatzBombMedia</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ManagedBass" Version="4.0.2" />
		<PackageReference Include="ManagedBass.Fx" Version="4.0.2" />
		<PackageReference Include="ManagedBass.Midi" Version="4.0.2" />

		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="SharpCompress" Version="0.49.1" />

		<PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />

	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FatzBomb.MediaControl.Tests" />
		<InternalsVisibleTo Include="FatzBomb.MediaControl.Rendering.Direct3D11" />
	</ItemGroup>

</Project>
