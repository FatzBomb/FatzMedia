<Window
    x:Class="FatzBombMedia.Player.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fbm="clr-namespace:FatzBombMedia.MediaControl.Wpf;assembly=FatzBombMedia.MediaControl.Wpf"
    Title="FatzBomb Media Player"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="540"
    AllowDrop="True"
    Background="#090B0E"
    DragEnter="Window_DragEnter"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    FontFamily="Segoe UI"
    Foreground="#F2F5F8"
    KeyDown="Window_KeyDown"
    MouseMove="Window_MouseMove"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#090B0E" />
        <SolidColorBrush x:Key="ViewportBrush" Color="#000000" />
        <SolidColorBrush x:Key="PanelBrush" Color="#10151B" />
        <SolidColorBrush x:Key="PanelOverlayBrush" Color="#EA10151B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#151B23" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#25303B" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#1E2630" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2A3541" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#151B22" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3EA6FF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA8B6" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#D4DAE2" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#697482" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FA" />
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="#354250" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4A5968" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            BasedOn="{StaticResource ChromeButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#7CCAFF" />
            <Setter Property="Foreground" Value="#06111A" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="MiniPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="Background" Value="#111821" />
            <Setter Property="BorderBrush" Value="#33404D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Double-click this viewport to enter/exit full screen. In full screen, BottomChrome becomes an auto-hide overlay.  -->
        <Border
            x:Name="MediaViewportBorder"
            Grid.Row="0"
            Margin="12,12,12,8"
            Padding="8"
            Background="Blue"
            BorderBrush="#151C24"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="12"
            MouseLeftButtonDown="MediaViewport_MouseLeftButtonDown">
            <fbm:MediaSurface
                x:Name="MediaSurface"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                OverlayHitTestVisible="False"
                Player="{Binding Player}"
                PresentationMode="{Binding PresentationMode}"
                VideoDisplayMode="{Binding VideoDisplayMode}" />
        </Border>

        <Grid
            x:Name="BottomChrome"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!--  Compact bottom player controls. Open is intentionally beside transport controls.  -->
            <Border
                x:Name="PlayerControlsPanel"
                Grid.Row="0"
                Padding="10,7"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#202A35"
                BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="8" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElapsedText}" />
                        <Grid
                            x:Name="SeekBar"
                            Grid.Column="2"
                            Height="22"
                            Background="Transparent"
                            Cursor="Hand"
                            IsEnabled="{Binding CanSeek}"
                            LostMouseCapture="SeekBar_LostMouseCapture"
                            MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                            MouseLeftButtonUp="SeekBar_MouseLeftButtonUp"
                            MouseMove="SeekBar_MouseMove"
                            SizeChanged="SeekBar_SizeChanged"
                            Visibility="{Binding CanSeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border
                                Height="6"
                                VerticalAlignment="Center"
                                Background="#26313D"
                                CornerRadius="3" />
                            <Canvas
                                x:Name="SeekCanvas"
                                Height="22"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                                <Border
                                    x:Name="SeekProgress"
                                    Canvas.Left="0"
                                    Canvas.Top="8"
                                    Width="0"
                                    Height="6"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3" />
                                <Ellipse
                                    x:Name="SeekThumb"
                                    Canvas.Top="4"
                                    Width="14"
                                    Height="14"
                                    Fill="#F4F7FA"
                                    Stroke="{StaticResource AccentBrush}"
                                    StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding RemainingText}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="OpenButton_Click"
                            Content="&#xE8E5;"
                            IsEnabled="{Binding CanOpen}"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Open media" />
                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding PlayCommand}"
                            Content="&#xE768;"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Play" />
                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding PauseCommand}"
                            Content="&#xE769;"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Pause" />
                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding StopCommand}"
                            Content="&#xE71A;"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Stop" />
                        <Button
                            x:Name="ProjectorButton"
                            Margin="5,0,0,0"
                            Click="ProjectorButton_Click"
                            Content="&#xE7F4;"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Toggle secondary/projector output validation" />
                        <Button
                            Margin="5,0,0,0"
                            Click="FullScreenButton_Click"
                            Content="&#xE740;"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Toggle full screen (double-click video also works)" />
                    </StackPanel>


                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="160"
                        MaxWidth="320"
                        HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="18"
                            FontWeight="Light"
                            Style="{StaticResource LabelTextStyle}"
                            Text="🔊" />
                        <Slider
                            Grid.Column="2"
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.1"
                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding Volume, StringFormat={}{0:P0}}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <CheckBox Content="Auto Play" IsChecked="{Binding AutoPlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="8,0,0,0"
                            Content="Loop Playback"
                            IsChecked="{Binding LoopPlayback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Grid
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            MinWidth="240"
                            MaxWidth="320"
                            Style="{StaticResource MiniPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="PITCH" />
                                <Slider
                                    Grid.Column="2"
                                    IsSnapToTickEnabled="True"
                                    Maximum="12"
                                    Minimum="-12"
                                    TickFrequency="1"
                                    Value="{Binding Pitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="{Binding Pitch, StringFormat={}{0:+0;-0;0} st}" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="2"
                            MinWidth="240"
                            MaxWidth="320"
                            Style="{StaticResource MiniPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="TEMPO" />
                                <Slider
                                    Grid.Column="2"
                                    IsSnapToTickEnabled="True"
                                    Maximum="200"
                                    Minimum="50"
                                    TickFrequency="5"
                                    Value="{Binding Tempo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="{Binding Tempo, StringFormat={}{0:0}%}" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="4"
                            MinWidth="390"
                            Style="{StaticResource MiniPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    Content="Normalize"
                                    IsChecked="{Binding Normalize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Grid.Column="2"
                                    MinWidth="92"
                                    Foreground="Black"
                                    ItemsSource="{Binding VideoDisplayModes}"
                                    SelectedItem="{Binding VideoDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Primary video display mode. Background videos behind overlays always use ZoomToFill." />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource LabelTextStyle}"
                                    Text="Native Overlay"
                                    ToolTip="The sample app always uses the native HWND + transparent overlay window path." />
                                <TextBlock
                                    Grid.Column="6"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource LabelTextStyle}"
                                    Text="BG" />
                                <Slider
                                    Grid.Column="7"
                                    Width="58"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="10"
                                    Value="{Binding CdgBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!--  Thin bottom status strip. In full screen this rides with the auto-hide overlay.  -->
            <Border
                x:Name="StatusStrip"
                Grid.Row="1"
                Padding="9,0"
                Background="#0D1116"
                BorderBrush="#1B242E"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{StaticResource AccentBrush}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding StatusText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
