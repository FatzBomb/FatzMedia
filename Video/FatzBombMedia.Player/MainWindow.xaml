<Window x:Class="FatzBombMedia.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fbm="clr-namespace:FatzBombMedia.MediaControl.Adapters.Wpf;assembly=FatzBombMedia.MediaControl"
        Title="FatzBomb Media Player"
        Height="720"
        Width="1120"
        MinHeight="540"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#090B0E"
        Foreground="#F2F5F8"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#090B0E" />
        <SolidColorBrush x:Key="ViewportBrush" Color="#000000" />
        <SolidColorBrush x:Key="PanelBrush" Color="#10151B" />
        <SolidColorBrush x:Key="PanelOverlayBrush" Color="#EA10151B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#151B23" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#25303B" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#1E2630" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2A3541" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#151B22" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3EA6FF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA8B6" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#D4DAE2" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#697482" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FA" />
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="#354250" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4A5968" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#7CCAFF" />
            <Setter Property="Foreground" Value="#06111A" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="MiniPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="Background" Value="#111821" />
            <Setter Property="BorderBrush" Value="#33404D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Double-click this viewport to enter/exit full screen. In full screen, BottomChrome becomes an auto-hide overlay. -->
        <Border x:Name="MediaViewportBorder"
                Grid.Row="0"
                Margin="12,12,12,8"
                Background="{StaticResource ViewportBrush}"
                BorderBrush="#151C24"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                ClipToBounds="True"
                MouseLeftButtonDown="MediaViewport_MouseLeftButtonDown">
            <fbm:FatzBombMediaSurface x:Name="MediaSurface"
                                      Player="{Binding Player}"
                                      VideoDisplayMode="{Binding VideoDisplayMode}"
                                      BitmapScalingMode="{Binding BitmapScalingMode}"
                                      PresentationMode="{Binding PresentationMode}"
                                      OverlayHitTestVisible="False"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
        </Border>

        <Grid x:Name="BottomChrome"
              Grid.Row="1"
              VerticalAlignment="Stretch"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!-- Compact bottom player controls. Open is intentionally beside transport controls. -->
            <Border x:Name="PlayerControlsPanel"
                    Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#202A35"
                    BorderThickness="0,1,0,1"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="8" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ElapsedText}"
                                   Style="{StaticResource ValueTextStyle}"
                                   HorizontalAlignment="Right"
                                   FontSize="12" />
                        <Grid x:Name="SeekBar"
                              Grid.Column="2"
                              Height="22"
                              Background="Transparent"
                              Cursor="Hand"
                              IsEnabled="{Binding CanSeek}"
                              Visibility="{Binding CanSeek, Converter={StaticResource BooleanToVisibilityConverter}}"
                              MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                              MouseMove="SeekBar_MouseMove"
                              MouseLeftButtonUp="SeekBar_MouseLeftButtonUp"
                              LostMouseCapture="SeekBar_LostMouseCapture"
                              SizeChanged="SeekBar_SizeChanged">
                            <Border Height="6"
                                    VerticalAlignment="Center"
                                    Background="#26313D"
                                    CornerRadius="3" />
                            <Canvas x:Name="SeekCanvas"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">
                                <Border x:Name="SeekProgress"
                                        Canvas.Left="0"
                                        Canvas.Top="8"
                                        Width="0"
                                        Height="6"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="3" />
                                <Ellipse x:Name="SeekThumb"
                                         Width="14"
                                         Height="14"
                                         Canvas.Top="4"
                                         Fill="#F4F7FA"
                                         Stroke="{StaticResource AccentBrush}"
                                         StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                        <TextBlock Grid.Column="4"
                                   Text="{Binding RemainingText}"
                                   Style="{StaticResource ValueTextStyle}"
                                   HorizontalAlignment="Left"
                                   FontSize="12" />
                    </Grid>

                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button Content="&#xE8E5;"
                                ToolTip="Open media"
                                Style="{StaticResource ChromeButtonStyle}"
                                Click="OpenButton_Click"
                                IsEnabled="{Binding CanOpen}" />
                        <Button Content="&#xE768;"
                                ToolTip="Play"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PlayCommand}"
                                Margin="5,0,0,0" />
                        <Button Content="&#xE769;"
                                ToolTip="Pause"
                                Style="{StaticResource ChromeButtonStyle}"
                                Command="{Binding PauseCommand}"
                                Margin="5,0,0,0" />
                        <Button Content="&#xE71A;"
                                ToolTip="Stop"
                                Style="{StaticResource ChromeButtonStyle}"
                                Command="{Binding StopCommand}"
                                Margin="5,0,0,0" />
                        <Button Content="&#xE740;"
                                ToolTip="Toggle full screen (double-click video also works)"
                                Style="{StaticResource ChromeButtonStyle}"
                                Click="FullScreenButton_Click"
                                Margin="5,0,0,0" />
                    </StackPanel>

                    
                    <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" MinWidth="160" MaxWidth="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔊" Style="{StaticResource LabelTextStyle}" FontSize="18" FontWeight="Light"/>
                        <Slider Grid.Column="2"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="0.1" />
                        <TextBlock Grid.Column="3"
                                    Text="{Binding Volume, StringFormat={}{0:P0}}"
                                    Style="{StaticResource ValueTextStyle}"
                                    HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                        <CheckBox Content="Auto Play"
                                  IsChecked="{Binding AutoPlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="8,0,0,0"
                                  Content="Loop Playback"
                                  IsChecked="{Binding LoopPlayback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                <Grid Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MiniPanelStyle}" MaxWidth="320" MinWidth="240">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PITCH" Style="{StaticResource LabelTextStyle}" />
                                <Slider Grid.Column="2"
                                    Minimum="-12"
                                    Maximum="12"
                                    Value="{Binding Pitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="3"
                                       Text="{Binding Pitch, StringFormat={}{0:+0;-0;0} st}"
                                       Style="{StaticResource ValueTextStyle}"
                                       HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MiniPanelStyle}" MaxWidth="320" MinWidth="240">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TEMPO" Style="{StaticResource LabelTextStyle}" />
                                <Slider Grid.Column="2"
                                    Minimum="50"
                                    Maximum="200"
                                    Value="{Binding Tempo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="3"
                                       Text="{Binding Tempo, StringFormat={}{0:0}%}"
                                       Style="{StaticResource ValueTextStyle}"
                                       HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource MiniPanelStyle}" MinWidth="390">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                      Content="Normalize"
                                      IsChecked="{Binding Normalize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2"
                                      MinWidth="92"
                                      Foreground="Black"
                                      ToolTip="Primary video display mode. Background videos behind overlays always use ZoomToFill."
                                      ItemsSource="{Binding VideoDisplayModes}"
                                      SelectedItem="{Binding VideoDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="4"
                                           Text="Native Overlay"
                                           ToolTip="The sample app always uses the native HWND + transparent overlay window path."
                                           Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Column="6"
                                       Text="BG"
                                       Style="{StaticResource LabelTextStyle}"
                                       Margin="0,0,6,0" />
                                <Slider Grid.Column="7"
                                    Width="58"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding CdgBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="9"
                                       Text="QUALITY"
                                       Style="{StaticResource LabelTextStyle}" />
                                <ComboBox Grid.Column="11" Foreground="Black"
                                      ItemsSource="{Binding QualityModes}"
                                      SelectedItem="{Binding BitmapScalingMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Thin bottom status strip. In full screen this rides with the auto-hide overlay. -->
            <Border x:Name="StatusStrip"
                    Grid.Row="1"
                    Background="#0D1116"
                    BorderBrush="#1B242E"
                    BorderThickness="0,1,0,0"
                    Padding="9,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               ToolTip="{Binding StatusText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
