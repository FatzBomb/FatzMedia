<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet metadata. Pack explicitly at release time (dotnet pack -c Release). -->
    <IsPackable>true</IsPackable>
    <PackageId>FatzMedia.Video.Direct3D11</PackageId>
    <AssemblyName>FatzMedia.Video.Direct3D11</AssemblyName>
    <RootNamespace>FatzMedia.Video.Direct3D11</RootNamespace>
    <Description>Direct3D 11 renderer and presentation backend for FatzMedia.Video.</Description>
    <PackageProjectUrl>https://github.com/FatzBomb/FatzMedia</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatzMedia.Video\FatzMedia.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="buildTransitive\FatzMedia.Video.Direct3D11.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FatzMedia.Video.Tests" />
  </ItemGroup>

</Project>
