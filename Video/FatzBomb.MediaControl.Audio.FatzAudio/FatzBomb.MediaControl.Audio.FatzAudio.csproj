<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet metadata. Pack explicitly at release time (dotnet pack -c Release). -->
    <IsPackable>true</IsPackable>
    <PackageId>FatzBomb.MediaControl.Audio.FatzAudio</PackageId>
    <AssemblyName>FatzBomb.MediaControl.Audio.FatzAudio</AssemblyName>
    <RootNamespace>FatzBomb.MediaControl.Audio.FatzAudio</RootNamespace>
    <Description>Opt-in FatzAudio audio engine for FatzBomb.MediaControl (stage 037A): plays audio files and archive entries through FatzAudio instead of BASS, selected with MediaPlayerConfiguration.AudioEngineFactory.</Description>
    <PackageProjectUrl>https://github.com/FatzBomb75/FatzBombMedia</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatzBomb.MediaControl\FatzBomb.MediaControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact pin: the binding refuses a native library of another major.minor, and a prerelease
         may break the API. GitHub Packages feed, see nuget.config and README.md. -->
    <PackageReference Include="FatzAudio" Version="[1.0.0-rc.1]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FatzBomb.MediaControl.Linux.Tests" />
  </ItemGroup>

</Project>
