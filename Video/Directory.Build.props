<Project>

  <PropertyGroup>
    <!-- true once this repo builds with 0 warnings: Release then fails on any warning (build\FatzBomb.Common.props). -->
    <FatzBombStrict>false</FatzBombStrict>
  </PropertyGroup>

  <!-- Shared FatzBomb settings, synced from shared\style; repo settings go below. -->
  <Import Project="build\FatzBomb.Common.props" />

  <!-- Brand / company identity shared across all FatzBomb packages (lockstep versioning). -->
  <PropertyGroup>
    <Version>0.1.0-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Keith Litfin</Authors>
    <Company>FatzBomb Entertainment</Company>
    <Copyright>Copyright (c) FatzBomb Entertainment. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/FatzBomb75/FatzBombMedia</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>