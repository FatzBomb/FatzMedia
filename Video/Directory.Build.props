<Project>

  <!--
    Repo-wide build settings inherited by every project in the solution.
    Project-level properties still override anything set here.
    Model / cost policy is NOT configured here.
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Brand / company identity shared across all FatzBomb packages (lockstep versioning). -->
  <PropertyGroup>
    <Version>0.1.0-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Keith Litfin</Authors>
    <Company>FatzBomb Entertainment</Company>
    <Copyright>Copyright (c) FatzBomb Entertainment. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/FatzBomb75/FatzBombMedia</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Release builds must be warning-clean; warnings fail the build. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
