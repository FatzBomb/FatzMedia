<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform Avalonia test player. The Windows platform package targets net10.0-windows7.0
    and the Linux one net10.0, and a net10.0 project cannot reference a Windows-TFM project, so
    the app multi-targets: each TFM references exactly one platform package and the platform
    factory is chosen at compile time (see PlatformComposition.cs). Run with
    `dotnet run -f net10.0` on Linux or `-f net10.0-windows7.0` on Windows.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows7.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FatzBomb.MediaControl.Player.Avalonia</AssemblyName>
    <RootNamespace>FatzBomb.MediaControl.Player.Avalonia</RootNamespace>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatzBomb.MediaControl\FatzBomb.MediaControl.csproj" />
    <ProjectReference Include="..\FatzBomb.MediaControl.Avalonia\FatzBomb.MediaControl.Avalonia.csproj" />
    <ProjectReference Include="..\FatzBomb.MediaControl.Player.Shared\FatzBomb.MediaControl.Player.Shared.csproj" />
    <ProjectReference Include="..\FatzBomb.MediaControl.Rendering.Software\FatzBomb.MediaControl.Rendering.Software.csproj" />
    <ProjectReference Include="..\FatzBomb.MediaControl.Rendering.Vulkan\FatzBomb.MediaControl.Rendering.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <ProjectReference Include="..\FatzBomb.MediaControl.Windows\FatzBomb.MediaControl.Windows.csproj" />
    <!-- Direct3D11 renderer for the shared GPU image path on Windows (Stage 027A slice 2). -->
    <ProjectReference Include="..\FatzBomb.MediaControl.Windows.Direct3D11\FatzBomb.MediaControl.Windows.Direct3D11.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'windows'">
    <ProjectReference Include="..\FatzBomb.MediaControl.Linux\FatzBomb.MediaControl.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BASS/FFmpeg binaries dropped into native/ (not tracked) are copied next to the app. -->
    <None Update="native\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
