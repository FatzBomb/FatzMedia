<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- NuGet metadata. Pack explicitly at release time (dotnet pack -c Release); not on every build. -->
		<IsPackable>true</IsPackable>
		<PackageId>FatzMedia.Video</PackageId>
		<AssemblyName>FatzMedia.Video</AssemblyName>
		<RootNamespace>FatzMedia.Video</RootNamespace>
		<Description>UI-agnostic FatzBomb media engine core: playback, timing, composition policy, state, CD+G, and renderer/platform contracts for audio/video/image/CD+G input, with FatzMedia.Audio (FatzAudio) and FFmpeg integration, normalization, and effects.</Description>
		<PackageProjectUrl>https://github.com/FatzBomb/FatzMedia</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<!-- The audio engine: FatzMedia.Audio from Audio\ in this repo. Its native library comes from Audio's CMake build:
		     FatzAudioNativeDir, default Audio\build\bin\Release (docs/NATIVE_DEPENDENCIES.md). -->
		<ProjectReference Include="..\..\Audio\bindings\dotnet\src\FatzMedia.Audio\FatzMedia.Audio.csproj" />

		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageReference Include="SharpCompress" Version="0.50.5" />

		<PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />

	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FatzMedia.Video.Tests" />
		<InternalsVisibleTo Include="FatzMedia.Video.Portable.Tests" />
		<InternalsVisibleTo Include="FatzMedia.Video.Linux.Tests" />
		<InternalsVisibleTo Include="FatzMedia.Video.Avalonia.Tests" />
	</ItemGroup>

</Project>
