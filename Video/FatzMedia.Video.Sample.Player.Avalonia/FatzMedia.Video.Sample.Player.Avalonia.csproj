<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform Avalonia test player. The Windows platform package targets net10.0-windows7.0
    and the Linux one net10.0, and a net10.0 project cannot reference a Windows-TFM project, so
    the app multi-targets: each TFM references exactly one platform package and the platform
    factory is chosen at compile time (see PlatformComposition.cs). Run with
    `dotnet run -f net10.0` on Linux or `-f net10.0-windows7.0` on Windows.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows7.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FatzMedia.Video.Sample.Player.Avalonia</AssemblyName>
    <RootNamespace>FatzMedia.Video.Sample.Player.Avalonia</RootNamespace>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatzMedia.Video\FatzMedia.Video.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Audio\FatzMedia.Video.Audio.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Avalonia\FatzMedia.Video.Avalonia.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Sample.Player.Shared\FatzMedia.Video.Sample.Player.Shared.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Software\FatzMedia.Video.Software.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Vulkan\FatzMedia.Video.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <ProjectReference Include="..\FatzMedia.Video.Windows\FatzMedia.Video.Windows.csproj" />
    <!-- Direct3D11 renderer for the shared GPU image path on Windows (Stage 027A slice 2). -->
    <ProjectReference Include="..\FatzMedia.Video.Windows.Direct3D11\FatzMedia.Video.Windows.Direct3D11.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'windows'">
    <ProjectReference Include="..\FatzMedia.Video.Linux\FatzMedia.Video.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BASS/FFmpeg binaries dropped into native/ (not tracked) are copied next to the app. -->
    <None Update="native\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
