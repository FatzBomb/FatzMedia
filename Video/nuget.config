<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the repository. Everything comes from nuget.org except the FatzAudio
  engine package (037A slice 2), which is on GitHub Packages. GitHub Packages needs a token even
  for reading: set FATZAUDIO_PACKAGES_TOKEN to a classic personal access token with read:packages
  (CI sets it to the workflow's GITHUB_TOKEN). See docs/NATIVE_DEPENDENCIES.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="FatzAudio" value="https://nuget.pkg.github.com/FatzBomb75/index.json" />
  </packageSources>
  <!-- Vulnerability data from nuget.org only, so restoring a project that does not use FatzAudio
       never needs the GitHub Packages token (NuGet audit queries every source otherwise, and
       Release treats its NU1900 warning as an error). -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceCredentials>
    <FatzAudio>
      <add key="Username" value="FatzBomb75" />
      <add key="ClearTextPassword" value="%FATZAUDIO_PACKAGES_TOKEN%" />
    </FatzAudio>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="FatzAudio">
      <package pattern="FatzAudio" />
    </packageSource>
  </packageSourceMapping>
</configuration>
