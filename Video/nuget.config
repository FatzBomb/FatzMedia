<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for Video: everything comes from nuget.org. FatzMedia.Audio is a project reference
  to Audio\ in this repo, so no other feed or token is needed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
