<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FatzMedia.Video.Sample.Player.WinForms</AssemblyName>
    <RootNamespace>FatzMedia.Video.Sample.Player.WinForms</RootNamespace>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatzMedia.Video\FatzMedia.Video.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Sample.Player.Shared\FatzMedia.Video.Sample.Player.Shared.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Software\FatzMedia.Video.Software.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Vulkan\FatzMedia.Video.Vulkan.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.WinForms\FatzMedia.Video.WinForms.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Windows\FatzMedia.Video.Windows.csproj" />
    <ProjectReference Include="..\FatzMedia.Video.Windows.Direct3D11\FatzMedia.Video.Windows.Direct3D11.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows renderer choice shared with the WPF player (Stage 046A slice 3). -->
    <Compile Include="..\FatzMedia.Video.Sample.Player\Configuration\PlayerRendererSelection.cs" Link="Configuration\PlayerRendererSelection.cs" />
    <!-- The native search paths, with the read-only install guard (ENG-039 W3). -->
    <Compile Include="..\FatzMedia.Video.Sample.Player\Configuration\PlayerNativeLibraries.cs" Link="Configuration\PlayerNativeLibraries.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg DLLs dropped into native/ (not tracked) are copied next to the app. -->
    <None Update="native\**\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="native\**\*.sf2" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
