<UserControl
    x:Class="FatzMedia.Video.Sample.Player.Controls.PlayerFlyoutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,7,0,0">
        <!--  Sync flyout  -->
        <Border Style="{StaticResource FlyoutPanelStyle}" Visibility="{Binding ActiveFlyout, Converter={StaticResource FlyoutVisibilityConverter}, ConverterParameter=Sync}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelTextStyle}"
                    Text="SYNC" />
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelTextStyle}"
                    Text="A/V" />
                <Button
                    Command="{Binding AdjustSyncCommand}"
                    CommandParameter="audio:-"
                    Content="−"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Delay video 100ms relative to audio" />
                <TextBlock
                    Width="42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ValueTextStyle}"
                    Text="{Binding AudioVideoSyncText}" />
                <Button
                    Command="{Binding AdjustSyncCommand}"
                    CommandParameter="audio:+"
                    Content="+"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Advance video 100ms relative to audio" />
                <TextBlock
                    Margin="12,0,5,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelTextStyle}"
                    Text="CDG" />
                <Button
                    Command="{Binding AdjustSyncCommand}"
                    CommandParameter="cdg:-"
                    Content="−"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Delay CDG 100ms" />
                <TextBlock
                    Width="42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ValueTextStyle}"
                    Text="{Binding CdgSyncText}" />
                <Button
                    Command="{Binding AdjustSyncCommand}"
                    CommandParameter="cdg:+"
                    Content="+"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Advance CDG 100ms" />
                <TextBlock
                    Margin="12,0,5,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelTextStyle}"
                    Text="SUB" />
                <Button
                    Command="{Binding AdjustSyncCommand}"
                    CommandParameter="subtitle:-"
                    Content="−"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Delay subtitles 100ms" />
                <TextBlock
                    Width="42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ValueTextStyle}"
                    Text="{Binding SubtitleSyncText}" />
                <Button
                    Command="{Binding AdjustSyncCommand}"
                    CommandParameter="subtitle:+"
                    Content="+"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Advance subtitles 100ms" />
                <Button
                    Width="48"
                    Margin="12,0,0,0"
                    Command="{Binding ResetSyncCommand}"
                    Content="Reset"
                    Style="{StaticResource SyncButtonStyle}"
                    ToolTip="Reset per-item sync offsets" />
                <TextBlock
                    Margin="18,0,6,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelTextStyle}"
                    Text="SUBTITLES" />
                <ComboBox
                    MinWidth="170"
                    DisplayMemberPath="Label"
                    IsEnabled="{Binding HasSubtitleChoices}"
                    ItemsSource="{Binding SubtitleChoices}"
                    SelectedItem="{Binding SelectedSubtitle, Mode=TwoWay}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Subtitle track: embedded tracks and sidecar files (.srt, .ass, .ssa) next to the media. Disabled when the media has none." />
            </StackPanel>
        </Border>

        <!--  Video flyout  -->
        <Border Style="{StaticResource FlyoutPanelStyle}" Visibility="{Binding ActiveFlyout, Converter={StaticResource FlyoutVisibilityConverter}, ConverterParameter=Video}">
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="HUE" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding HueDegrees, StringFormat={}{0:+0;-0;0}°}" />
                        </DockPanel>
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="180"
                            Minimum="-180"
                            TickFrequency="15"
                            Value="{Binding HueDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="SATURATION" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding Saturation, StringFormat={}{0:0.00}×}" />
                        </DockPanel>
                        <Slider
                            Maximum="2"
                            Minimum="0"
                            TickFrequency="0.05"
                            Value="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="BRIGHTNESS" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding Brightness, StringFormat={}{0:+0.00;-0.00;0.00}}" />
                        </DockPanel>
                        <Slider
                            Maximum="0.25"
                            Minimum="-0.25"
                            TickFrequency="0.025"
                            Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="CONTRAST" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding Contrast, StringFormat={}{0:0.00}×}" />
                        </DockPanel>
                        <Slider
                            Maximum="1.5"
                            Minimum="0.5"
                            TickFrequency="0.05"
                            Value="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock
                                Foreground="#FF7777"
                                Style="{StaticResource LabelTextStyle}"
                                Text="RED" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding RedGain, StringFormat={}{0:0.00}×}" />
                        </DockPanel>
                        <Slider
                            Maximum="2"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="Red channel gain: 0 removes red, 1 is neutral, 2 doubles red"
                            Value="{Binding RedGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock
                                Foreground="#70DB88"
                                Style="{StaticResource LabelTextStyle}"
                                Text="GREEN" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding GreenGain, StringFormat={}{0:0.00}×}" />
                        </DockPanel>
                        <Slider
                            Maximum="2"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="Green channel gain: 0 removes green, 1 is neutral, 2 doubles green"
                            Value="{Binding GreenGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock
                                Foreground="#72A7FF"
                                Style="{StaticResource LabelTextStyle}"
                                Text="BLUE" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding BlueGain, StringFormat={}{0:0.00}×}" />
                        </DockPanel>
                        <Slider
                            Maximum="2"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="Blue channel gain: 0 removes blue, 1 is neutral, 2 doubles blue"
                            Value="{Binding BlueGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>
                <DockPanel Margin="0,7,0,0" HorizontalAlignment="Center">
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="Include Overlays"
                        IsChecked="{Binding IncludeOverlays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Apply base-visual color transforms to subtitle/karaoke/CDG overlay surfaces as well" />
                    <Button
                        Width="92"
                        Command="{Binding ResetBaseVisualTransformCommand}"
                        Content="Reset Visual"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Restore all base-visual transforms to identity" />
                </DockPanel>
                <!--  Scaled CD+G look (ENG-064): applied live by FatzAudio, playing or paused  -->
                <DockPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LabelTextStyle}"
                        Text="CD+G LOOK" />
                    <CheckBox
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Content="Scaled"
                        IsChecked="{Binding CdgScaled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Draw CD+G smoothed in full colour (FatzAudio) instead of the classic 300x216 picture scaled up" />
                    <CheckBox
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Content="Edge blend"
                        IsChecked="{Binding CdgEdgeBlend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Anti-alias stair steps along colour edges (no effect at smoothness 5 and up)" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LabelTextStyle}"
                        Text="RENDER" />
                    <ComboBox
                        MinWidth="110"
                        Margin="0,0,14,0"
                        ItemsSource="{Binding CdgRenderHeights}"
                        SelectedItem="{Binding CdgRenderHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Height the picture is drawn at before the GPU scales it to the screen; it is drawn at the largest whole multiple of 216 that fits" />
                    <Button
                        Width="92"
                        Command="{Binding ResetCdgLookCommand}"
                        Content="Reset Look"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Smoothness 6, edge blend on, no outline, shadow or bevel, drawn at the canvas size" />
                </DockPanel>
                <WrapPanel Margin="0,4,0,0" HorizontalAlignment="Center">
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="SMOOTHNESS" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding CdgSmoothness}" />
                        </DockPanel>
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="0"
                            TickFrequency="1"
                            ToolTip="0 sharp pixels, 1-4 softer, 5-10 traced outlines: straighter diagonals, rounder corners, curves at 9 and 10"
                            Value="{Binding CdgSmoothness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="OUTLINE" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding CdgOutlineSize, StringFormat={}{0:0.00}}" />
                        </DockPanel>
                        <Slider
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="Black outline width: 0 none, 1 is 1.5 CD+G pixels"
                            Value="{Binding CdgOutlineSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="SHADOW SIZE" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding CdgShadowSize, StringFormat={}{0:0.00}}" />
                        </DockPanel>
                        <Slider
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="How far the soft shadow spreads: 1 is 2 CD+G pixels"
                            Value="{Binding CdgShadowSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="SHADOW DIST" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding CdgShadowDistance, StringFormat={}{0:0.00}}" />
                        </DockPanel>
                        <Slider
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="How far down and right the shadow falls: 1 is 2 CD+G pixels. Shadow is off when size and distance are both 0"
                            Value="{Binding CdgShadowDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="BEVEL" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding CdgBevelStrength, StringFormat={}{0:0.00}}" />
                        </DockPanel>
                        <Slider
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="Bevel strength: a highlight top left and a shade bottom right; 0 none"
                            Value="{Binding CdgBevelStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ValidationParameterStyle}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="BEVEL SIZE" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding CdgBevelSize, StringFormat={}{0:0.00}}" />
                        </DockPanel>
                        <Slider
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            ToolTip="How far the bevel reaches in from the edge: 1 is 1 CD+G pixel"
                            Value="{Binding CdgBevelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  Audio flyout  -->
        <Border Style="{StaticResource FlyoutPanelStyle}" Visibility="{Binding ActiveFlyout, Converter={StaticResource FlyoutVisibilityConverter}, ConverterParameter=Audio}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Border
                        MinWidth="240"
                        MaxWidth="320"
                        Style="{StaticResource MiniPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="PITCH" />
                            <Slider
                                Grid.Column="2"
                                IsSnapToTickEnabled="True"
                                Maximum="12"
                                Minimum="-12"
                                TickFrequency="1"
                                Value="{Binding Pitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding Pitch, StringFormat={}{0:+0;-0;0} st}" />
                        </Grid>
                    </Border>
                    <Border
                        MinWidth="240"
                        MaxWidth="320"
                        Margin="8,0,0,0"
                        Style="{StaticResource MiniPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="TEMPO" />
                            <Slider
                                Grid.Column="2"
                                IsSnapToTickEnabled="True"
                                Maximum="200"
                                Minimum="50"
                                TickFrequency="5"
                                Value="{Binding Tempo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding Tempo, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Border>
                </StackPanel>
                <DockPanel Margin="0,7,0,0" HorizontalAlignment="Center">
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="Normalize"
                        IsChecked="{Binding Normalize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="Reset Pitch on Load"
                        IsChecked="{Binding ResetPitchOnMediaLoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Reset pitch to 0 after the next successful media load" />
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="Reset Tempo on Load"
                        IsChecked="{Binding ResetTempoOnMediaLoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Reset tempo to 100% after the next successful media load" />
                    <CheckBox
                        Content="Silent Drag"
                        IsChecked="{Binding SilentDrag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Mute audio while the seek bar is dragged; it plays again when the drag rests or is released" />
                </DockPanel>
                <Border
                    Margin="0,7,0,0"
                    Padding="8,5"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MiniPanelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                            <CheckBox
                                Content="EQ"
                                IsChecked="{Binding EqualizerEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="10-band graphic equalizer (applied before normalization and fades). Off or flat attaches nothing." />
                            <Button
                                Width="48"
                                Margin="0,6,0,0"
                                Command="{Binding FlattenEqualizerCommand}"
                                Content="Flat"
                                Style="{StaticResource SyncButtonStyle}"
                                ToolTip="Set every band to 0 dB" />
                        </StackPanel>
                        <ItemsControl IsEnabled="{Binding EqualizerEnabled}" ItemsSource="{Binding EqualizerBands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="36">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ValueTextStyle}"
                                            Text="{Binding GainDb, StringFormat={}{0:+0;-0;0}}" />
                                        <Slider
                                            Height="72"
                                            Margin="0,2"
                                            HorizontalAlignment="Center"
                                            IsSnapToTickEnabled="True"
                                            Maximum="12"
                                            Minimum="-12"
                                            Orientation="Vertical"
                                            TickFrequency="1"
                                            ToolTip="{Binding ToolTipText}"
                                            Value="{Binding GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource LabelTextStyle}"
                                            Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--  A/V flyout  -->
        <Border Style="{StaticResource FlyoutPanelStyle}" Visibility="{Binding ActiveFlyout, Converter={StaticResource FlyoutVisibilityConverter}, ConverterParameter=AV}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <CheckBox Content="Auto Play" IsChecked="{Binding AutoPlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="8,0,0,0"
                        Content="Auto Hide"
                        IsChecked="{Binding AutoHideSurfaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Hide the internal presentation host until visual content is ready" />
                    <CheckBox
                        x:Name="SecondaryWindowCheckBox"
                        Margin="8,0,0,0"
                        Click="SecondaryWindowCheckBox_Click"
                        Content="Secondary Window"
                        ToolTip="Toggle secondary/projector output validation" />
                    <CheckBox
                        Margin="8,0,0,0"
                        Content="Display-Locked"
                        IsChecked="{Binding DisplayLockedTiming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Time video frames to each monitor's refreshes (even 3:2 for 24 fps on 60 Hz). Needs the Direct3D11 renderer with native windows; the Log panel says when it is on." />
                </StackPanel>
                <Border
                    Margin="0,7,0,0"
                    Padding="8,5"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MiniPanelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextStyle}"
                            Text="DISPLAY" />
                        <ComboBox
                            MinWidth="92"
                            ItemsSource="{Binding VideoDisplayModes}"
                            SelectedItem="{Binding VideoDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Primary video display mode. Background videos behind overlays always use ZoomToFill." />
                        <TextBlock
                            Margin="10,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextStyle}"
                            Text="MODE" />
                        <ComboBox
                            MinWidth="138"
                            IsEnabled="{Binding CanChangePresentationMode}"
                            ItemsSource="{Binding PresentationModes}"
                            SelectedItem="{Binding PresentationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Native HWND is fastest. WPF composited avoids HWND airspace limitations at a readback cost. Selectable with the GPU renderer while no media is open. The software renderer (--software) supports WPF composited only." />
                        <TextBlock
                            Margin="10,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextStyle}"
                            Text="PLAYER" />
                        <ComboBox
                            MinWidth="104"
                            IsEnabled="{Binding CanSwitchMode}"
                            ItemsSource="{Binding PlayerModes}"
                            SelectedItem="{Binding PlayerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Player mode (Stage 043A): Full, Background (video only, always loops) or Audio (sound only, no picture). Switches on the fly with a short gap, like a seek; --mode= sets the startup mode." />
                        <TextBlock
                            Margin="10,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextStyle}"
                            Text="BG" />
                        <Slider
                            Width="80"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="10"
                            Value="{Binding CdgBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--  Next flyout: prepared-next slot, fades, and network streams  -->
        <Border Style="{StaticResource FlyoutPanelStyle}" Visibility="{Binding ActiveFlyout, Converter={StaticResource FlyoutVisibilityConverter}, ConverterParameter=Next}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LabelTextStyle}"
                        Text="NEXT" />
                    <Button
                        Width="78"
                        Command="{Binding ChooseNextCommand}"
                        Content="Choose..."
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Pick the next item; it is analyzed in the background while the current item plays" />
                    <TextBlock
                        MinWidth="220"
                        MaxWidth="420"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{Binding PreparedNextText}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Width="96"
                        Command="{Binding PlayNextNowCommand}"
                        Content="Play next now"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Switch to the prepared item now (fades when FADE is above 0)" />
                    <Button
                        Width="52"
                        Margin="6,0,0,0"
                        Command="{Binding ClearNextCommand}"
                        Content="Clear"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Forget the prepared item" />
                </StackPanel>
                <StackPanel
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Content="Auto-next"
                        IsChecked="{Binding AutoNext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Start the prepared item automatically when the current one ends" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LabelTextStyle}"
                        Text="FADE" />
                    <Slider
                        Width="120"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="10"
                        Minimum="0"
                        TickFrequency="0.5"
                        ToolTip="Fade length for transitions to the next item; 0 switches instantly"
                        Value="{Binding FadeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Width="36"
                        Margin="6,0,14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{Binding FadeSeconds, StringFormat={}{0:0.#}s}" />
                    <Button
                        Width="70"
                        Command="{Binding FadeOutCommand}"
                        Content="Fade out"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="{Binding FadeOutToolTip}" />
                    <Button
                        Width="62"
                        Margin="6,0,0,0"
                        Command="{Binding FadeInCommand}"
                        Content="Fade in"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="{Binding FadeInToolTip}" />
                    <Button
                        Width="58"
                        Margin="6,0,0,0"
                        Command="{Binding CancelFadeCommand}"
                        Content="Cancel"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Stop the running fade; the volume stays where the fade reached" />
                </StackPanel>
                <StackPanel
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LabelTextStyle}"
                        Text="URL" />
                    <TextBox
                        Width="320"
                        VerticalAlignment="Center"
                        Text="{Binding NetworkUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="http:// or https:// audio stream (internet radio or an MP3/OGG file)" />
                    <Button
                        Width="64"
                        Margin="6,0,0,0"
                        Command="{Binding OpenUrlCommand}"
                        Content="Open"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Load the URL as the current item" />
                    <TextBlock
                        MinWidth="160"
                        MaxWidth="320"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{Binding StreamInfoText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Log flyout: engine diagnostics, newest first  -->
        <Border Style="{StaticResource FlyoutPanelStyle}" Visibility="{Binding ActiveFlyout, Converter={StaticResource FlyoutVisibilityConverter}, ConverterParameter=Log}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LabelTextStyle}"
                        Text="LOG" />
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{Binding DiagnosticLog.Count, StringFormat='{}{0} entries, newest first'}" />
                    <Button
                        Width="64"
                        Command="{Binding CopyLogCommand}"
                        Content="Copy all"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Copy every entry, oldest first, to the clipboard" />
                    <Button
                        Width="52"
                        Margin="6,0,0,0"
                        Command="{Binding ClearLogCommand}"
                        Content="Clear"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="Clear this list (the log file keeps everything)" />
                    <Button
                        Width="92"
                        Margin="6,0,0,0"
                        Command="{Binding OpenLogFileCommand}"
                        Content="Open log file"
                        Style="{StaticResource SyncButtonStyle}"
                        ToolTip="{Binding LogFilePath}" />
                </StackPanel>
                <ListBox
                    Width="860"
                    Height="240"
                    Margin="0,7,0,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    FontFamily="Consolas"
                    FontSize="11"
                    ItemsSource="{Binding DiagnosticLog}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#FFC857" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="#FF6B6B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding Category}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Category}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{StaticResource SoftTextBrush}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
