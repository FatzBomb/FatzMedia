<Window
    x:Class="FatzBomb.MediaControl.Player.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fbm="clr-namespace:FatzBomb.MediaControl.Wpf;assembly=FatzBomb.MediaControl.Wpf"
    xmlns:local="clr-namespace:FatzBomb.MediaControl.Player"
    xmlns:controls="clr-namespace:FatzBomb.MediaControl.Player.Controls"
    Title="FatzBomb Media Player"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="540"
    AllowDrop="True"
    Background="#090B0E"
    DragEnter="Window_DragEnter"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    FontFamily="Segoe UI"
    Foreground="#F2F5F8"
    KeyDown="Window_KeyDown"
    MouseMove="Window_MouseMove"
    WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Double-click this viewport to enter/exit full screen. In full screen, BottomChrome becomes an auto-hide overlay.  -->
        <Border
            x:Name="MediaViewportBorder"
            Grid.Row="0"
            Margin="12,12,12,8"
            Padding="8"
            Background="{StaticResource ViewportBrush}"
            BorderBrush="#151C24"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="12"
            MouseLeftButtonDown="MediaViewport_MouseLeftButtonDown">
            <fbm:MediaSurface
                x:Name="MediaSurface"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                AutoHide="{Binding AutoHideSurfaces}"
                OverlayHitTestVisible="False"
                Player="{Binding Player}"
                PresentationMode="{Binding PresentationMode}"
                VideoDisplayMode="{Binding VideoDisplayMode}" />
        </Border>

        <Grid
            x:Name="BottomChrome"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!--  Compact bottom player controls. Open is intentionally beside transport controls.  -->
            <Border
                x:Name="PlayerControlsPanel"
                Grid.Row="0"
                Padding="10,7"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#202A35"
                BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="8" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 0: Timeline / seek bar  -->
                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElapsedText}" />
                        <Grid
                            x:Name="SeekBar"
                            Grid.Column="2"
                            Height="22"
                            Background="Transparent"
                            Cursor="Hand"
                            IsEnabled="{Binding CanSeek}"
                            LostMouseCapture="SeekBar_LostMouseCapture"
                            MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                            MouseLeftButtonUp="SeekBar_MouseLeftButtonUp"
                            MouseMove="SeekBar_MouseMove"
                            SizeChanged="SeekBar_SizeChanged"
                            Visibility="{Binding CanSeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border
                                Height="6"
                                VerticalAlignment="Center"
                                Background="#26313D"
                                CornerRadius="3" />
                            <Canvas
                                x:Name="SeekCanvas"
                                Height="22"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                                <Border
                                    x:Name="SeekProgress"
                                    Canvas.Left="0"
                                    Canvas.Top="8"
                                    Width="0"
                                    Height="6"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3" />
                                <Ellipse
                                    x:Name="SeekThumb"
                                    Canvas.Top="4"
                                    Width="14"
                                    Height="14"
                                    Fill="#F4F7FA"
                                    Stroke="{StaticResource AccentBrush}"
                                    StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding RemainingText}" />
                    </Grid>

                    <!--  Row 1: Transport controls, flyout toggle buttons, volume, fullscreen  -->
                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Transport: Open, Play, Pause, Stop, Loop  -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal">
                            <Button
                                Click="OpenButton_Click"
                                Content="&#xE8E5;"
                                IsEnabled="{Binding CanOpen}"
                                Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Open media" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding PlayCommand}"
                                Content="&#xE768;"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Play" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding PauseCommand}"
                                Content="&#xE769;"
                                Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Pause" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding StopCommand}"
                                Content="&#xE71A;"
                                Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Stop" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding ToggleLoopCommand}"
                                Content="&#xE8EE;"
                                Style="{StaticResource ToggleChromeButtonStyle}"
                                Tag="{Binding LoopPlayback}"
                                ToolTip="Loop playback" />
                        </StackPanel>

                        <!--  Flyout toggle buttons  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding ToggleFlyoutCommand}"
                                CommandParameter="Sync"
                                Content="Sync"
                                Style="{StaticResource FlyoutButtonStyle}"
                                Tag="{Binding IsSyncFlyoutActive}"
                                ToolTip="Sync offsets" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding ToggleFlyoutCommand}"
                                CommandParameter="Video"
                                Content="Video"
                                Style="{StaticResource FlyoutButtonStyle}"
                                Tag="{Binding IsVideoFlyoutActive}"
                                ToolTip="Video color and visual transforms" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding ToggleFlyoutCommand}"
                                CommandParameter="Audio"
                                Content="Audio"
                                Style="{StaticResource FlyoutButtonStyle}"
                                Tag="{Binding IsAudioFlyoutActive}"
                                ToolTip="Audio effects" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding ToggleFlyoutCommand}"
                                CommandParameter="AV"
                                Content="A/V"
                                Style="{StaticResource FlyoutButtonStyle}"
                                Tag="{Binding IsAVFlyoutActive}"
                                ToolTip="Playback, display, and output settings" />
                        </StackPanel>

                        <!--  Volume  -->
                        <Grid Grid.Column="3" MinWidth="210">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="18"
                                FontWeight="Light"
                                Style="{StaticResource LabelTextStyle}"
                                Text="🔊" />
                            <Slider
                                Grid.Column="2"
                                Maximum="1"
                                Minimum="0"
                                TickFrequency="0.1"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ValueTextStyle}"
                                Text="{Binding Volume, StringFormat={}{0:P0}}" />
                        </Grid>

                        <!--  Fullscreen  -->
                        <Button
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            Click="FullScreenButton_Click"
                            Content="&#xE740;"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Toggle full screen (double-click video also works)" />
                    </Grid>

                    <!--  Row 2: Active flyout content  -->
                    <controls:PlayerFlyoutPanel
                        x:Name="FlyoutPanel"
                        Grid.Row="2"
                        Grid.Column="1" />
                </Grid>
            </Border>

            <!--  Thin bottom status strip. In full screen this rides with the auto-hide overlay.  -->
            <Border
                x:Name="StatusStrip"
                Grid.Row="1"
                Padding="9,0"
                Background="#0D1116"
                BorderBrush="#1B242E"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{StaticResource AccentBrush}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding StatusText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
