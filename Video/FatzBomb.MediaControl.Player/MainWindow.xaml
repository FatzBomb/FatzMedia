<Window
    x:Class="FatzBomb.MediaControl.Player.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FatzBomb Media Player"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="540"
    Background="#090B0E"
    FontFamily="Segoe UI"
    Foreground="#F2F5F8"
    KeyDown="Window_KeyDown"
    WindowStartupLocation="CenterScreen">

    <!--  1-4 independent players (players=N on the command line), each its own view model, side by side.  -->
    <UniformGrid x:Name="PlayersGrid" Background="{StaticResource WindowBrush}" Columns="1" />
</Window>
