<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x64</PlatformTarget>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Deterministic>true</Deterministic>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- NuGet metadata -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>FatzBombMedia.MediaControl</PackageId>
		<AssemblyName>FatzBombMedia.MediaControl</AssemblyName>
		<RootNamespace>FatzBombMedia.MediaControl</RootNamespace>
		<Description>WPF media control library for karaoke/video/audio/image playback using BASS, FFmpeg, CDG rendering, audio effects, normalization, and automatic rendering selection.</Description>
		<Authors>Keith Litfin</Authors>
		<Company>FatzBomb Entertainment</Company>
		<RepositoryUrl>https://github.com/FatzBomb75/FatzBombMedia</RepositoryUrl>
		<PackageProjectUrl>https://github.com/FatzBomb75/FatzBombMedia</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DebugType>portable</DebugType>

		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<InformationalVersion>0.1.0-alpha</InformationalVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ManagedBass" Version="4.0.2" />
		<PackageReference Include="ManagedBass.Fx" Version="4.0.2" />

		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="SharpCompress" Version="0.49.1" />

		<PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />

		<PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
		<PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
		<PackageReference Include="Vortice.DXGI" Version="3.8.3" />
		<PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
